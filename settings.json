        "hooks": [
          {
            "type": "command",
            "command": "python3 'C:\\Users\\whyhe\\.agents\\skills\\token-optimizer\\scripts\\measure.py' compact-capture --trigger stop"
          }
        ]
      }
    ],
    "PreToolUse": [
